# Travel data APIs
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
OPENTRIPMAP_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Optional persistence
MONGO_URI=
